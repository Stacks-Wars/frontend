# =============================================================================
# Stacks Wars Frontend
# Copy to `.env.local` for local development.
# =============================================================================

# Neon Auth — Console → stacks wars → Branch (dev) → Auth
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth

# Cookie signing for auth session proxy. Min 32 chars.
# Generate: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=your-secret-at-least-32-characters-long

# Canonical app origin
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rust API
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080

# Multiplexed app WebSocket (SessionManager + topics)
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8080/app

# Shared secret for server-to-server user sync (must match backend)
INTERNAL_API_SECRET=your-shared-internal-api-secret

# Stacks network for custodial wallets
NEXT_PUBLIC_NETWORK=testnet

# Google Cloud KMS — encrypt custodial mnemonics at rest (production)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# KMS_LOCATION=global
# KMS_KEY_RING=stacks-wars
# KMS_CRYPTO_KEY=custodial-wallet-keys
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Local-only fallback when KMS is not configured (min 32 chars)
CUSTODIAL_DEV_SECRET=local-dev-secret-at-least-32-chars!!
