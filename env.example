# =============================================================================
# Stacks Wars Frontend
# Copy to `.env.local` for local development.
# =============================================================================

# Neon Auth — Console → stacks wars → Branch (dev) → Auth
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth

# Cookie signing for auth session proxy. Min 32 chars.
# Generate: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=your-secret-at-least-32-characters-long

DISABLE_VERIFICATION=true

# Canonical app origin
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rust API
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080

# Multiplexed app WebSocket (SessionManager + topics)
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8080/app

HIRO_API_KEY=

# Central vault + oracle/sponsor mnemonic (STACKS_WARS_KEY is frontend-only)
SW_VAULT_CONTRACT=SP299MBHT7FPPP2SKEY73V4DHW67467SED87A4HH4.sw-vault-v1
STACKS_WARS_KEY=word1 word2 ... word24

# Stacks network for custodial wallets / wait-for-tx
NEXT_PUBLIC_NETWORK=mainnet

# Custodial mnemonic encryption (local). Generate: openssl rand -base64 32
CUSTODIAL_DEV_SECRET=your-secret-at-least-16-characters

# Shared with backend for S2S / lobby TTL cron
INTERNAL_API_SECRET=

# Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# USDCx / min entry / withdraw limits are hardcoded in
# frontend/lib/vault/config.ts (and backend config.rs).
